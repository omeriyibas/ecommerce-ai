# Kopyala: cp .env.example .env  — lokal uv run; .env commit etme
# Docker Compose için: cp .env.docker.example .env.docker

DEBUG=True
# Host Postgres (sayaç yapısı); Docker API → host.docker.internal (.env.docker)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/ecommerce_ai
DB_SSL=disable

LOG_LEVEL=INFO
LOG_TO_FILE=True
CORS_ORIGINS=*

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=True
UVICORN_WORKERS=1

RATE_LIMIT_ENABLED=True
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SEC=3600
RATE_LIMIT_ADMIN_MAX=5
RATE_LIMIT_ADMIN_WINDOW_SEC=3600
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW_SEC=60

DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=900
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=60

JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ALG=HS256
JWT_ISS=ecommerce-ai-api
JWT_AUD=ecommerce-ai-clients
ACCESS_MIN=30
REFRESH_DAYS=7
COOKIE_SAMESITE=lax

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
LIST_CACHE_TTL_SEC=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET=
S3_PREFIX=uploads/
S3_PRESIGN_EXPIRES_SEC=3600
UPLOAD_MAX_BYTES=5000000

ADMIN_API_KEY=CHANGE_ME
ADMIN_ENABLED=True
ADMIN_ALLOWED_IPS=127.0.0.1,::1
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12,100.64.0.0/10

API_REQUEST_DELAY_MS=0

# --- AI ---
OPENAI_API_KEY=
OPENAI_MODEL=openai:gpt-5-mini
OPENAI_RESPONSES_MODEL=openai-responses:gpt-5-mini
OPENAI_FALLBACK_MODEL=
AGENT_RETRIES=2
AGENT_TIMEOUT=60
RESEARCH_TIMEOUT=120
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.2
ROUTER_TEMPERATURE=0
RESEARCH_TEMPERATURE=0.5
AGENT_THINKING=
AGENT_ITER_LOG=true
DEFAULT_USER_ID=15

LOGFIRE_ENABLED=true
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=ecommerce-ai-api
LOGFIRE_ENVIRONMENT=dev
